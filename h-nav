#!/bin/sh
# h-nav: Neovim-aware directional pane focus, the herdr half of
# nvim-herdr-navigator (the vim-tmux-navigator pattern for herdr; tmux
# side equivalent: `if-shell "$is_vim" send-keys ...`).
#
# Runs as a plugin action (see herdr-plugin.toml), bound to the direct
# ctrl+h/j/k/l chords as [[keys.command]] type="plugin_action" in the
# user's config.toml. Keybindings forward the chord to Neovim or fzf.
# The Neovim plugin tries its windows first, then invokes the same action
# via the CLI at its layout edge. CLI invocations focus panes without
# forwarding keys. fzf handles the key itself. For other processes,
# including Vim, use pane navigation: the most recently used (MRU)
# neighbour from $HERDR_PLUGIN_STATE_DIR/pane-mru, else native focus.

set -eu

reset_history() {
  : >"$HERDR_PLUGIN_STATE_DIR/pane-mru"
}

# Record request sources, not confirmed focus changes.
record_source() (
  printf '%s\n' "$1" >>"$HERDR_PLUGIN_STATE_DIR/pane-mru"
)

focus_mru() (
  dir=$1
  pane_id=$2
  [ -n "${HERDR_SOCKET_PATH:-}" ] || return 1
  [ -n "${HERDR_PLUGIN_ROOT:-}" ] || return 1
  command -v nc >/dev/null 2>&1 || return 1
  history=$(tail -n 256 "$HERDR_PLUGIN_STATE_DIR/pane-mru") || return 1
  # A lone source cannot select itself. Avoid a layout request in this case.
  [ -n "$history" ] && [ "$history" != "$pane_id" ] || return 1

  layout=$("$herdr" pane layout --pane "$pane_id") || return 1
  target=$(printf '%s\n' "$layout" | jq -er \
    --arg dir "$dir" --arg source "$pane_id" \
    --arg history "$history" \
    -f "$HERDR_PLUGIN_ROOT/lib/select-mru.jq") || return 1

  printf '{"id":"h-nav","method":"pane.focus","params":{"pane_id":"%s"}}\n' "$target" |
    nc -U -w 1 "$HERDR_SOCKET_PATH" | jq -e .result >/dev/null
)

dir="${1-}"
case "$dir" in
--reset)
  reset_history
  exit
  ;;
left) key=ctrl+h ;;
down) key=ctrl+j ;;
up) key=ctrl+k ;;
right) key=ctrl+l ;;
*)
  echo "usage: h-nav left|down|up|right|--reset" >&2
  exit 2
  ;;
esac

herdr=${HERDR_BIN_PATH:?must run as a herdr plugin action}
# Set by herdr for plugin actions; identifies the pane for this invocation.
pane_id=${HERDR_PANE_ID:?must run as a herdr plugin action}

# jq is required for every invocation, including key forwarding.
# Reject missing/invalid sources rather than risking an edge-handoff loop.
invocation_source=$(printf '%s\n' "${HERDR_PLUGIN_CONTEXT_JSON:-}" |
  jq -er '.invocation_source | select(type == "string" and length > 0)') || {
  echo "h-nav: cannot read invocation_source from HERDR_PLUGIN_CONTEXT_JSON (requires jq)" >&2
  exit 1
}

nvim_or_fzf_in_pane() {
  # Match Neovim or fzf process names, including wrapped binaries.
  pattern='\.?(nvim(diff)?|fzf)(-wrapped)?'
  "$herdr" pane process-info --pane "$pane_id" |
    grep -iqE "\"name\":\"($pattern)\""
}

# invocation_source
# - keybinding: a Herdr keyboard binding
# - cli: `herdr plugin action invoke` call from nvim
if [ "$invocation_source" = keybinding ] && nvim_or_fzf_in_pane; then
  # Forward keys only for keybindings. Neovim tries its windows first,
  # then invokes this action via the CLI at its layout edge.
  exec "$herdr" pane send-keys "$pane_id" "$key"
fi

# Pane navigation, including Neovim's CLI invocation at its window edge.
if record_source "$pane_id"; then
  if focus_mru "$dir" "$pane_id"; then
    exit 0
  fi
else
  echo "h-nav: could not update history" >&2
fi

# Fallback, no history or MRU failure
result=$("$herdr" pane focus --direction "$dir" --pane "$pane_id") || exit

# No pane that way: hand the edge to the herdr client, which wraps around or
# moves focus into its sidebar. Herdr builds without client.focus_edge reject
# the request, which leaves focus where it is.
if printf '%s\n' "$result" | jq -e '.result.focus.changed == false' >/dev/null &&
  [ -n "${HERDR_SOCKET_PATH:-}" ] && command -v nc >/dev/null 2>&1; then
  printf '{"id":"h-nav","method":"client.focus_edge","params":{"direction":"%s"}}\n' "$dir" |
    nc -U -w 1 "$HERDR_SOCKET_PATH" >/dev/null 2>&1 || true
fi
