#!/bin/sh
# h-nav: Neovim-aware directional pane focus, the herdr half of
# nvim-herdr-navigator (the vim-tmux-navigator pattern for herdr; tmux
# side equivalent: `if-shell "$is_vim" send-keys ...`).
#
# Runs as a plugin action (see herdr-plugin.toml), bound to the direct
# ctrl+h/j/k/l chords as [[keys.command]] type="plugin_action" in the
# user's config.toml. Pass the chord through to Neovim or fzf.
# The Neovim plugin tries its windows first, then calls `herdr pane focus`
# at its layout edge. fzf handles the key itself. For other processes,
# including Vim, move focus directly to the neighbouring herdr pane.

set -eu

dir=$1
case $dir in
left) key=ctrl+h ;;
down) key=ctrl+j ;;
up) key=ctrl+k ;;
right) key=ctrl+l ;;
*)
  echo "usage: h-nav left|down|up|right" >&2
  exit 2
  ;;
esac

herdr=${HERDR_BIN_PATH:?must run as a herdr plugin action}
# Set by herdr for plugin actions; holds the focused pane at keypress time.
pane_id=${HERDR_PANE_ID:?must run as a herdr plugin action}

nvim_or_fzf_in_pane() {
  # Match Neovim or fzf process names, including wrapped binaries.
  pattern='\.?(nvim(diff)?|fzf)(-wrapped)?'
  "$herdr" pane process-info --pane "$pane_id" |
    grep -iqE "\"name\":\"($pattern)\""
}

if nvim_or_fzf_in_pane; then
  # Pass the key through: Neovim tries its windows first and requests
  # herdr pane focus only at its layout edge; fzf handles the key itself.
  exec "$herdr" pane send-keys "$pane_id" "$key"
else
  exec "$herdr" pane focus --direction "$dir" --pane "$pane_id"
fi
